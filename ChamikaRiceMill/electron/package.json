{
  "name": "chamika-rice-mill",
  "private": true,
  "version": "1.0.1",
  "description": "Chamika Rice Mill - Offline-First Desktop Application",
  "author": "Chamika",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5181 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "antd": "^6.1.4",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "dexie": "^4.0.4",
    "electron-updater": "^6.6.2",
    "js-cookie": "^3.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^8.55.0",
    "postcss": "^8.5.21",
    "tailwindcss": "^3.4.19",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.chamika.ricemill",
    "productName": "Chamika Rice Mill - Officer Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chamika Rice Mill",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "artifactName": "Chamika-Mill-Setup-${version}.exe"
    },
    "extraResources": [
      "app-update.yml"
    ],
    "publish": {
      "provider": "github",
      "owner": "thumuladinu",
      "repo": "chamika-mill-releases",
      "releaseType": "release"
    }
  }
}
